# PaperclipNET environment example
# Do not commit real secrets.

# Optional explicit config path when running outside the repo root
# PAPERCLIP_CONFIG=./config/paperclip.config.json

# Agent auth secret (required by local adapter/authenticated operations)
PAPERCLIP_AGENT_JWT_SECRET=replace-with-secure-random-value

# Optional explicit base URL overrides
PAPERCLIP_PUBLIC_URL=https://busone.estrategiasdenegocios.ar
BETTER_AUTH_TRUSTED_ORIGINS=https://busone.estrategiasdenegocios.ar

# Server runtime
PORT=3002

# Optional database URL only if migrating away from embedded postgres
# DATABASE_URL=postgres://user:password@host:5432/paperclip
