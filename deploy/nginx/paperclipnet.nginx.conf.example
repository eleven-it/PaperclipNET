# PaperclipNET nginx reference config
# Example only. Adjust domain/certs/paths before production use.

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

limit_req_zone $binary_remote_addr zone=paperclipnet_general:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=paperclipnet_auth:10m rate=5r/m;

upstream paperclipnet_upstream {
    server 127.0.0.1:3100;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name paperclip.example.com;

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name paperclip.example.com;

    # Example certificate paths
    ssl_certificate /etc/letsencrypt/live/paperclip.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/paperclip.example.com/privkey.pem;

    access_log /var/log/nginx/paperclipnet.access.log;
    error_log /var/log/nginx/paperclipnet.error.log warn;

    client_max_body_size 20m;
    keepalive_timeout 65;

    location / {
        limit_req zone=paperclipnet_general burst=30 nodelay;

        proxy_pass http://paperclipnet_upstream;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    location ~* ^/(auth|login|api/auth) {
        limit_req zone=paperclipnet_auth burst=10 nodelay;

        proxy_pass http://paperclipnet_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}
